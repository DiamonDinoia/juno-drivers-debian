#!/bin/bash
set -e

product_model="$(sed -e 's/^\s*//g' -e 's/\s*$//g' "/sys/devices/virtual/dmi/id/product_name" | tr ' ,/-' '_')"
chassis="$(hostnamectl 2>/dev/null | awk 'FNR==3 {print $2}')"

case "$product_model" in
	NUC10i3FNH|NUC10i5FNH|NUC10i7FNH|NUC10i3FNK|NUC10i5FNK|NUC10i7FNK)
		echo "Olympia 8th Gen ($chassis)"
		if grep 'hw:0,0' /etc/pulse/default.pa; then
			echo "Olympia (10th Gen) headphone jack drivers already exist"
		else
			echo 'load-module module-alsa-sink device=hw:0,0' >> /etc/pulse/default.pa
			echo "Olympia (10th Gen) headphone jack drivers installed"
		fi
		;;
esac

# Offline so the same call is right on a live install and in a container.
SYSTEMD_OFFLINE=1 systemctl enable thermald

case "$product_model" in
	PE60RNE_RND_RNC)
		cp /usr/share/junocomp/juno-audio-fix.conf /etc/modprobe.d/juno-audio-fix.conf
		;;
esac

case "$product_model" in
	NP5x_NP6x_NP7xHP|NP5x_NP7xHH_HJ_HK)
		cp /usr/share/junocomp/restore-i2c-hid /usr/lib/systemd/system-sleep/restore-i2c-hid
		chmod +x /usr/lib/systemd/system-sleep/restore-i2c-hid
		;;
esac

case "$product_model" in
	NJx0AU|NJ7xPU|NJ7xMU)
		cp /usr/share/junocomp/60-nj70au-touchpad.conf /usr/share/X11/xorg.conf.d/60-nj70au-touchpad.conf
		;;
esac

if command -v glib-compile-schemas >/dev/null; then
	glib-compile-schemas /usr/share/glib-2.0/schemas/
fi

# Local CPU policy: the standalone turbo toggles replace the old service.
if command -v systemctl >/dev/null 2>&1; then
	systemctl disable --now disable-cpu-turbo.service >/dev/null 2>&1 || true
fi

ppd_present=0
if command -v powerprofilesctl >/dev/null 2>&1 || \
	[ -e /usr/lib/systemd/system/power-profiles-daemon.service ] || \
	[ -e /lib/systemd/system/power-profiles-daemon.service ]; then
	ppd_present=1
fi

case "$product_model" in
	NL50RU|NL51RU|NL5xRU|NL4x_NL5xRU|NL5xNU|NL4x_NLxNU|NH5xVR|V5xTNC_TND_TNE)
		if [ "$ppd_present" -eq 1 ]; then
			rm -f /etc/udev/rules.d/juno-cpufreq.rules
			echo "Skipping juno-cpufreq.rules because power-profiles-daemon is present"
		else
			ln -sfn /usr/share/nv41/udev/juno-cpufreq.rules /etc/udev/rules.d/juno-cpufreq.rules
			echo "Installed juno-cpufreq.rules"
		fi
		;;
esac

if command -v update-grub >/dev/null 2>&1; then
	update-grub
fi

#DEBHELPER#
